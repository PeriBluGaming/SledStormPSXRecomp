diff --git a/runtime/tests/test_ws_reveal_edge.c b/runtime/tests/test_ws_reveal_edge.c
new file mode 100644
index 0000000000000000000000000000000000000000..35f6f2aa8ac45d9c06b65252e002988ce6626c06
--- /dev/null
+++ b/runtime/tests/test_ws_reveal_edge.c
@@ -0,0 +1,151 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <assert.h>
+#include <stdio.h>
+#include "ws_reveal_edge.h"
+#include "ws_hud_anchor.h"
+
+/* Bands only extend an outer boundary that already reaches the canonical
+ * edge, only on requested sides, never overlap the quad and never touch a
+ * full-frame quad (the renderer's single full-screen path owns that). */
+static void test_geometry(void) {
+    WsScreenMaskBand b[2];
+    /* A menu bar authored from x=-20 to 532 on a 512-wide display. */
+    int32_t x[4] = {-20, 532, -20, 532}, y[4] = {-20, -20, 42, 42};
+    assert(ws_reveal_edge_bands(x, y, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b) == 2);
+    assert(b[0].x == -85 && b[0].w == 65 && b[0].y == -20 && b[0].h == 62);
+    assert(b[1].x == 532 && b[1].w == 65 && b[1].y == -20 && b[1].h == 62);
+    assert(ws_reveal_edge_bands(x, y, 512, 256, 85, WS_REVEAL_EDGE_LEFT, b) == 1);
+    assert(b[0].x == -85 && b[0].w == 65);
+    assert(ws_reveal_edge_bands(x, y, 512, 256, 85, WS_REVEAL_EDGE_RIGHT, b) == 1);
+    assert(b[0].x == 532 && b[0].w == 65);
+    assert(ws_reveal_edge_bands(x, y, 512, 256, 85, 0, b) == 0);
+
+    /* Divider line: only the end at the display edge grows; the interior end
+     * at x=46 (joined to a curved piece) stays where it was authored. */
+    int32_t lx[4] = {46, 532, 46, 532}, ly[4] = {24, 24, 25, 25};
+    assert(ws_reveal_edge_bands(lx, ly, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b) == 1);
+    assert(b[0].x == 532 && b[0].w == 65 && b[0].y == 24 && b[0].h == 1);
+
+    /* Tint halves in the middle of the screen: each grows on its outer side. */
+    int32_t tx[4] = {-30, 256, -30, 256}, ty[4] = {43, 43, 213, 213};
+    assert(ws_reveal_edge_bands(tx, ty, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b) == 1);
+    assert(b[0].x == -85 && b[0].w == 55 && b[0].y == 43 && b[0].h == 170);
+    tx[0] = tx[2] = 256; tx[1] = tx[3] = 542;
+    assert(ws_reveal_edge_bands(tx, ty, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b) == 1);
+    assert(b[0].x == 542 && b[0].w == 55);
+
+    /* Exactly on the edge grows by the whole margin. */
+    int32_t ex[4] = {0, 512, 0, 512}, ey[4] = {10, 10, 20, 20};
+    assert(ws_reveal_edge_bands(ex, ey, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b) == 2);
+    assert(b[0].x == -85 && b[0].w == 85 && b[1].x == 512 && b[1].w == 85);
+
+    /* Interior quad, or one already covering the reveal: nothing to add. */
+    int32_t ix[4] = {1, 511, 1, 511};
+    assert(!ws_reveal_edge_bands(ix, ey, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b));
+    int32_t cx[4] = {-128, 641, -128, 641};
+    assert(!ws_reveal_edge_bands(cx, ey, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b));
+    cx[0] = cx[2] = -85; cx[1] = cx[3] = 597;
+    assert(!ws_reveal_edge_bands(cx, ey, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b));
+
+    /* Full-frame quad belongs to the renderer's full-screen expansion. */
+    int32_t fx[4] = {0, 512, 0, 512}, fy[4] = {0, 0, 256, 256};
+    assert(!ws_reveal_edge_bands(fx, fy, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b));
+    fy[0] = fy[1] = 1;   /* not full height: a panel again */
+    assert(ws_reveal_edge_bands(fx, fy, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b) == 2);
+
+    /* Mirrored quads are still axis aligned. */
+    int32_t mx[4] = {532, -20, 532, -20};
+    assert(ws_reveal_edge_bands(mx, y, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b) == 2);
+
+    /* Slanted, degenerate, no reveal, bad display. */
+    int32_t sx[4] = {-20, 532, -10, 532};
+    assert(!ws_reveal_edge_bands(sx, y, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b));
+    int32_t sy[4] = {-20, -19, 42, 42};
+    assert(!ws_reveal_edge_bands(x, sy, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b));
+    int32_t zy[4] = {5, 5, 5, 5};
+    assert(!ws_reveal_edge_bands(x, zy, 512, 256, 85, WS_REVEAL_EDGE_BOTH, b));
+    assert(!ws_reveal_edge_bands(x, y, 512, 256, 0, WS_REVEAL_EDGE_BOTH, b));
+    assert(!ws_reveal_edge_bands(x, y, 0, 256, 85, WS_REVEAL_EDGE_BOTH, b));
+    assert(!ws_reveal_edge_bands(x, y, 512, 256, 85, WS_REVEAL_EDGE_BOTH, NULL));
+
+    /* Every band stays inside [-margin, width + margin) and off the quad. */
+    for (int margin = 1; margin < 400; margin += 7)
+        for (int left = -margin - 5; left <= 5; left += 3) {
+            int32_t qx[4] = {left, 600, left, 600}, qy[4] = {3, 3, 9, 9};
+            int n = ws_reveal_edge_bands(qx, qy, 512, 256, margin,
+                                         WS_REVEAL_EDGE_BOTH, b);
+            for (int i = 0; i < n; i++) {
+                assert(b[i].w > 0 && b[i].x >= -margin);
+                assert(b[i].x + b[i].w <= 512 + margin);
+                assert(b[i].x + b[i].w <= left || b[i].x >= 600);
+            }
+        }
+}
+
+static void test_packets(void) {
+    /* Flat quad, opaque and translucent. */
+    uint32_t f4[5] = {0x28284759u, 0, 0, 0, 0};
+    assert(ws_reveal_edge_packet_ok(f4, 5));
+    f4[0] = 0x2A284759u;
+    assert(ws_reveal_edge_packet_ok(f4, 5));
+    assert(!ws_reveal_edge_packet_ok(f4, 4));
+    /* Textured quad with one texel (108,77) in all four UVs. */
+    uint32_t ft4[9] = {0x2C808080u, 0, 0x7EE24D6Cu, 0, 0x00094D6Cu,
+                       0, 0x00004D6Cu, 0, 0x00004D6Cu};
+    assert(ws_reveal_edge_packet_ok(ft4, 9));
+    ft4[0] = 0x2E808080u;
+    assert(ws_reveal_edge_packet_ok(ft4, 9));
+    for (int i = 2; i <= 8; i += 2) {   /* any differing texel rejects */
+        ft4[i] ^= 1u;
+        assert(!ws_reveal_edge_packet_ok(ft4, 9));
+        ft4[i] ^= 1u;
+    }
+    assert(!ws_reveal_edge_packet_ok(ft4, 8));
+    /* Other primitives: triangles, Gouraud, sprites, lines. */
+    const uint32_t ops[] = {0x20, 0x24, 0x30, 0x38, 0x3C, 0x40, 0x60, 0x64};
+    for (unsigned i = 0; i < sizeof ops / sizeof ops[0]; i++) {
+        uint32_t w[12] = {ops[i] << 24};
+        for (uint32_t n = 1; n <= 12; n++) assert(!ws_reveal_edge_packet_ok(w, n));
+    }
+    assert(!ws_reveal_edge_packet_ok(NULL, 5));
+}
+
+static void test_tag_storage(void) {
+    /* The side set survives the clamped anchor field of the tag table. */
+    for (int e = WS_REVEAL_EDGE_LEFT; e <= WS_REVEAL_EDGE_BOTH; e++)
+        assert(ws_reveal_edge_from_anchor(
+                   ws_hud_anchor_clamp(ws_reveal_edge_to_anchor(e))) == e);
+
+    /* Packet guard and lifetime are the shared anchor-table rules. */
+    WsHudAnchorTag tags[WS_HUD_ANCHOR_TABLE_SIZE] = {0};
+    uint32_t words[5] = {0x2A284759u, 0xFFE2002Bu, 0x00E20100u,
+                         0x00D5FFE2u, 0x00D50100u};
+    WsPrepassPacketGuard guard = ws_prepass_packet_guard(words, 5);
+    ws_hud_anchor_insert(tags, WS_HUD_ANCHOR_TABLE_SIZE, 0x104B88u,
+                         ws_reveal_edge_to_anchor(WS_REVEAL_EDGE_RIGHT),
+                         &guard, 40);
+    int anchor = 0;
+    assert(ws_hud_anchor_lookup(tags, WS_HUD_ANCHOR_TABLE_SIZE, 0x104B88u,
+                                words, 5, 40, &anchor));
+    assert(ws_reveal_edge_from_anchor(anchor) == WS_REVEAL_EDGE_RIGHT);
+    assert(ws_hud_anchor_lookup(tags, WS_HUD_ANCHOR_TABLE_SIZE, 0x104B88u,
+                                words, 5, 40 + WS_HUD_ANCHOR_FRESH_FRAMES, NULL));
+    assert(!ws_hud_anchor_lookup(tags, WS_HUD_ANCHOR_TABLE_SIZE, 0x104B88u,
+                                 words, 5, 41 + WS_HUD_ANCHOR_FRESH_FRAMES, NULL));
+    for (int i = 0; i < 5; i++) {
+        words[i] ^= 0x10u;
+        assert(!ws_hud_anchor_lookup(tags, WS_HUD_ANCHOR_TABLE_SIZE, 0x104B88u,
+                                     words, 5, 40, NULL));
+        words[i] ^= 0x10u;
+    }
+}
+
+int main(void) {
+    test_geometry();
+    test_packets();
+    test_tag_storage();
+    puts("ws_reveal_edge_test: PASS");
+    return 0;
+}
diff --git a/runtime/tests/test_ws_reveal_edge_exec.c b/runtime/tests/test_ws_reveal_edge_exec.c
new file mode 100644
index 0000000000000000000000000000000000000000..57afd80d4d88cac45021e04cd1f4ccab46fcebd3
--- /dev/null
+++ b/runtime/tests/test_ws_reveal_edge_exec.c
@@ -0,0 +1,292 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+/* Reveal-edge quads through the real GP0 handlers: tagged flat and one-texel
+ * textured quads add bands only outside the authored quad, with the quad's
+ * blend, CLUT, texture page and texel, while the original draw, guest RAM and
+ * every untagged or invalid case stay exactly as before. */
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "../src/gpu.c"
+
+/* Record the renderer calls this test observes instead of the shared stubs. */
+#define gr_draw_flat_rect reveal_stub_flat_rect
+#define gr_draw_textured_rect_scaled reveal_stub_scaled_rect
+#define gr_set_semi_transparency reveal_stub_semi
+#define gr_set_color_modulation reveal_stub_modulation
+#include "gpu_exec_stubs.inc"
+#undef gr_draw_flat_rect
+#undef gr_draw_textured_rect_scaled
+#undef gr_set_semi_transparency
+#undef gr_set_color_modulation
+
+typedef struct { int x, y, w, h, u0, v0, u1, v1, clut_x, clut_y, tpage, semi, mode; uint16_t color; } Rect;
+static Rect flat_rects[8], scaled_rects[8];
+static int flat_count, scaled_count, cur_semi, cur_mode, cur_r, cur_g, cur_b;
+
+void gr_set_semi_transparency(int enabled, int mode) { cur_semi = enabled; cur_mode = mode; }
+void gr_set_color_modulation(int r, int g, int b, int raw_texture) {
+    (void)raw_texture; cur_r = r; cur_g = g; cur_b = b;
+}
+void gr_draw_flat_rect(int x, int y, int w, int h, uint16_t color) {
+    assert(flat_count < 8);
+    flat_rects[flat_count++] = (Rect){x, y, w, h, 0, 0, 0, 0, 0, 0, 0, cur_semi, cur_mode, color};
+}
+void gr_draw_textured_rect_scaled(int x, int y, int w, int h, int u0, int v0,
+                                  int u1, int v1, uint16_t clut_x,
+                                  uint16_t clut_y, uint16_t texpage) {
+    assert(scaled_count < 8);
+    scaled_rects[scaled_count++] = (Rect){x, y, w, h, u0, v0, u1, v1, clut_x,
+                                          clut_y, texpage, cur_semi, cur_mode, 0};
+}
+
+static uint32_t pack_vertex(int x, int y) {
+    return (uint16_t)(int16_t)x | ((uint32_t)(uint16_t)(int16_t)y << 16);
+}
+
+/* Display and draw registers of a 320-wide frame buffer at VRAM (0,0). */
+static void apply_test_registers(void) {
+    gp0_cmd_source_addr = 0xFFFFFFFFu;
+    draw_offset_x = 0;
+    draw_offset_y = 0;
+    draw_area_left = 0;
+    draw_area_top = 0;
+    draw_area_right = 1023;
+    draw_area_bottom = 511;
+    hres1 = 1;
+    hres2 = 0;
+    video_mode = 0;
+    display_depth = 0;
+    display_disabled = 0;
+    display_area_x = 0;
+    display_area_y = 0;
+    h_display_x1 = 0x200;
+    h_display_x2 = 0xC00;
+    v_display_y1 = 0x010;
+    v_display_y2 = 0x100;
+    semi_transparency = 2;
+    ws_mode = 0;
+    ws_cfg_num = 4;
+    ws_cfg_den = 3;
+    ws_xnum = 1;
+    ws_xden = 1;
+    ws_full_2d = 0;
+}
+
+static void reset_gpu_state_for_test(void) {
+    memset(test_ram, 0, sizeof(test_ram));
+    gpu_reset_state(0);
+    s_frame_count = 100;
+    apply_test_registers();
+}
+
+static void configure_native_wide_16_9(void) {
+    ws_mode = 2;
+    ws_cfg_num = 16;
+    ws_cfg_den = 9;
+    ws_full_2d = 1;
+}
+
+/* Place a packet at command address `addr` and execute it. */
+static void exec_packet(uint32_t addr, const uint32_t *words, uint32_t n) {
+    memcpy(&test_ram[addr / 4u], words, n * sizeof(uint32_t));
+    memcpy(gp0_cmd_buf, words, n * sizeof(uint32_t));
+    gp0_cmd_source_addr = addr;
+    gp0_words_needed = (int)n;
+    flat_count = scaled_count = 0;
+    gpu_exec_reset_triangles();
+    if (((words[0] >> 24) & 0xFCu) == 0x28u) gp0_exec_mono_quad();
+    else gp0_exec_textured_quad();
+}
+
+#define TINT_ADDR 0x00010004u
+#define BAR_ADDR  0x00010104u
+#define LINE_ADDR 0x00010204u
+
+static void tint_packet(uint32_t w[5], int x0, int x1) {
+    w[0] = 0x2A284759u;
+    w[1] = pack_vertex(x0, 43); w[2] = pack_vertex(x1, 43);
+    w[3] = pack_vertex(x0, 213); w[4] = pack_vertex(x1, 213);
+}
+
+/* One-texel bar: texel (108,77), CLUT (544,508), texture page 9. */
+static void bar_packet(uint32_t w[9], int x0, int x1, int y0, int y1, int texel_v) {
+    const uint32_t uv = 108u | ((uint32_t)texel_v << 8);
+    const uint32_t clut = (544u / 16u) | (508u << 6);
+    w[0] = 0x2C808080u;
+    w[1] = pack_vertex(x0, y0); w[2] = uv | (clut << 16);
+    w[3] = pack_vertex(x1, y0); w[4] = uv | (9u << 16);
+    w[5] = pack_vertex(x0, y1); w[6] = uv;
+    w[7] = pack_vertex(x1, y1); w[8] = uv;
+}
+
+static void test_translucent_tint(int W, int M) {
+    uint32_t w[5];
+    tint_packet(w, -30, W / 2);
+    reset_gpu_state_for_test();
+    configure_native_wide_16_9();
+    exec_packet(TINT_ADDR, w, 5);                      /* untagged reference */
+    assert(flat_count == 1);
+    const Rect original = flat_rects[0];
+    assert(original.x == -30 && original.w == W / 2 + 30 && original.y == 43 && original.h == 170);
+
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    exec_packet(TINT_ADDR, w, 5);
+    assert(flat_count == 2);
+    /* Band first, then the untouched original; same colour, same blend. */
+    assert(flat_rects[0].x == -M && flat_rects[0].w == M - 30);
+    assert(flat_rects[0].y == 43 && flat_rects[0].h == 170);
+    assert(flat_rects[0].color == original.color);
+    assert(flat_rects[0].semi == 1 && flat_rects[0].mode == 2);
+    assert(memcmp(&flat_rects[1], &original, sizeof original) == 0);
+    /* The band ends where the quad begins: no overlap, no double blend. */
+    assert(flat_rects[0].x + flat_rects[0].w == original.x);
+
+    uint32_t ram[5];
+    memcpy(ram, &test_ram[TINT_ADDR / 4u], sizeof ram);
+    assert(memcmp(ram, w, sizeof ram) == 0);           /* guest packet unchanged */
+}
+
+static void test_one_texel_bar(int W, int M) {
+    uint32_t w[9];
+    bar_packet(w, -20, W + 20, -20, 42, 77);
+    reset_gpu_state_for_test();
+    configure_native_wide_16_9();
+    draw_offset_y = 8;
+    exec_packet(BAR_ADDR, w, 9);
+    assert(scaled_count == 1);                          /* original only */
+    const Rect original = scaled_rects[0];
+
+    gpu_ws_tag_reveal_edge_quad(0x80000000u | (BAR_ADDR - 4u), WS_REVEAL_EDGE_BOTH);
+    exec_packet(BAR_ADDR, w, 9);
+    assert(scaled_count == 3);
+    for (int i = 0; i < 2; i++) {
+        const Rect *b = &scaled_rects[i];
+        assert(b->u0 == 108 && b->u1 == 108 && b->v0 == 77 && b->v1 == 77);
+        assert(b->clut_x == 544 && b->clut_y == 508 && b->tpage == 9);
+        assert(b->y == -20 + 8 && b->h == 62);
+    }
+    assert(scaled_rects[0].x == -M && scaled_rects[0].w == M - 20);
+    assert(scaled_rects[1].x == W + 20 && scaled_rects[1].w == M - 20);
+    assert(memcmp(&scaled_rects[2], &original, sizeof original) == 0);
+    assert(cur_r == 0x80 && cur_g == 0x80 && cur_b == 0x80);
+
+    /* A line whose inner end joins other artwork grows only at the edge. */
+    uint32_t l[9];
+    bar_packet(l, 46, W + 20, 24, 25, 72);
+    memcpy(&test_ram[LINE_ADDR / 4u], l, sizeof l);
+    gpu_ws_tag_reveal_edge_quad(LINE_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    exec_packet(LINE_ADDR, l, 9);
+    assert(scaled_count == 2);
+    assert(scaled_rects[0].x == W + 20 && scaled_rects[0].w == M - 20);
+    assert(scaled_rects[1].x == 46);
+}
+
+static void test_rejections(int W) {
+    uint32_t w[9], t[5];
+    bar_packet(w, -20, W + 20, -20, 42, 77);
+    tint_packet(t, -30, W / 2);
+
+    /* Native 4:3: nothing is tagged, nothing grows. */
+    reset_gpu_state_for_test();
+    memcpy(&test_ram[BAR_ADDR / 4u], w, sizeof w);
+    gpu_ws_tag_reveal_edge_quad(BAR_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    assert(!ws_reveal_edge_tags_used);
+    exec_packet(BAR_ADDR, w, 9);
+    assert(scaled_count == 1);
+
+    /* Two texels, bad alignment, no side, wrong primitive. */
+    reset_gpu_state_for_test();
+    configure_native_wide_16_9();
+    w[8] ^= 1u;
+    memcpy(&test_ram[BAR_ADDR / 4u], w, sizeof w);
+    gpu_ws_tag_reveal_edge_quad(BAR_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    w[8] ^= 1u;
+    memcpy(&test_ram[TINT_ADDR / 4u], t, sizeof t);
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 2u, WS_REVEAL_EDGE_BOTH);
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 4u, 0);
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 4u, 4);
+    const uint32_t tri[4] = {0x20284759u, pack_vertex(-30, 43), pack_vertex(9, 43), pack_vertex(-30, 99)};
+    memcpy(&test_ram[LINE_ADDR / 4u], tri, sizeof tri);
+    gpu_ws_tag_reveal_edge_quad(LINE_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    assert(!ws_reveal_edge_tags_used);
+
+    /* Tagged, then the packet changes: the guard drops the tag. */
+    memcpy(&test_ram[TINT_ADDR / 4u], t, sizeof t);
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    t[1] = pack_vertex(-31, 43); t[3] = pack_vertex(-31, 213);
+    exec_packet(TINT_ADDR, t, 5);
+    assert(flat_count == 1);
+
+    /* Expiry after the shared freshness window. */
+    tint_packet(t, -30, W / 2);
+    memcpy(&test_ram[TINT_ADDR / 4u], t, sizeof t);
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    s_frame_count += WS_HUD_ANCHOR_FRESH_FRAMES;
+    exec_packet(TINT_ADDR, t, 5);
+    assert(flat_count == 2);
+    s_frame_count += 1;
+    exec_packet(TINT_ADDR, t, 5);
+    assert(flat_count == 1);
+
+    /* Native-wide switched off after tagging. */
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    ws_mode = 0;
+    exec_packet(TINT_ADDR, t, 5);
+    assert(flat_count == 1);
+    configure_native_wide_16_9();
+
+    /* An explicit HUD anchor on the same packet wins. */
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    gpu_ws_tag_hud_prim(TINT_ADDR - 4u, 1);
+    exec_packet(TINT_ADDR, t, 5);
+    assert(flat_count == 1);
+}
+
+static void test_reset_and_savestate(int W) {
+    uint32_t t[5];
+    tint_packet(t, -30, W / 2);
+    reset_gpu_state_for_test();
+    configure_native_wide_16_9();
+    memcpy(&test_ram[TINT_ADDR / 4u], t, sizeof t);
+
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    gpu_reset_state(0);
+    apply_test_registers();
+    configure_native_wide_16_9();
+    assert(!ws_reveal_edge_tags_used);
+    exec_packet(TINT_ADDR, t, 5);
+    assert(flat_count == 1);
+
+    static uint8_t snap[1u << 22];
+    const uint32_t n = gpu_snapshot_bytes();
+    assert(n <= sizeof snap);
+    gpu_snapshot_write(snap);
+    gpu_ws_tag_reveal_edge_quad(TINT_ADDR - 4u, WS_REVEAL_EDGE_BOTH);
+    exec_packet(TINT_ADDR, t, 5);
+    assert(flat_count == 2);
+    assert(gpu_snapshot_read(snap, n));
+    configure_native_wide_16_9();
+    assert(!ws_reveal_edge_tags_used);
+    exec_packet(TINT_ADDR, t, 5);
+    assert(flat_count == 1);
+}
+
+int main(void) {
+    reset_gpu_state_for_test();
+    configure_native_wide_16_9();
+    assert(ws_native_wide_active());
+    const int W = (int)ws_disp_w(), M = (int)draw_area_wide_x_margin();
+    assert(W > 0 && M > 30);
+    test_translucent_tint(W, M);
+    test_one_texel_bar(W, M);
+    test_rejections(W);
+    test_reset_and_savestate(W);
+    printf("ws_reveal_edge_exec_test: PASS (display %d, reveal %d)\n", W, M);
+    return 0;
+}
